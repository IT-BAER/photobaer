{
  "name": "photobaer",
  "short_name": "photobaer",
  "description": "Free, open-source photo editor that runs in the browser, works offline and opens and saves PSD files.",
  "categories": ["photo", "graphics", "productivity"],
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#16181b",
  "theme_color": "#16181b",
  "icons": [
    { "src": "icon-192-v2.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512-v2.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "application/x-photobaer": [".pbaer"],
        "image/vnd.adobe.photoshop": [".psd"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
