{
  "name": "photobaer",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:engine": "cargo build --release --target wasm32-unknown-unknown --manifest-path engine/Cargo.toml && wasm-bindgen --target web --out-dir app/src/engine-pkg engine/target/wasm32-unknown-unknown/release/photobaer_engine.wasm",
    "dev": "vite",
    "build": "pnpm build:engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path engine/Cargo.toml && node --import ./scripts/lingui-node.mjs --test \"app/src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "corpus": "node tests/corpus.ts",
    "i18n:extract": "lingui extract --clean"
  },
  "dependencies": {
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "ag-psd": "31.0.2",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/native-tools": "0.1.5",
    "@lingui/vite-plugin": "6.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
