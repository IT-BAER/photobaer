{
  "name": "photobaer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:engine": "cargo build --release --target wasm32-unknown-unknown --manifest-path engine/Cargo.toml && wasm-bindgen --target web --out-dir app/src/engine-pkg engine/target/wasm32-unknown-unknown/release/photobaer_engine.wasm",
    "dev": "vite",
    "build": "pnpm build:engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path engine/Cargo.toml && node --test \"app/src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "corpus": "node tests/corpus.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
